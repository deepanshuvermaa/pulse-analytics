# `RUN npm ci` runs before `COPY . .`, so without this the host's node_modules
# is copied over the freshly installed one — shipping Windows/macOS native
# binaries into a linux container.
node_modules
dist
.git
.gitignore
.env
.env.*
!.env.example
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.vscode
.idea
coverage
*.docx
README.md

# MCP server is published separately; the API image does not run it.
mcp
